# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/Maniac/[Ll]ibrary/
/Maniac/[Tt]emp/
/Maniac/[Oo]bj/
/Maniac/[Bb]uild/
/Maniac/[Bb]uilds/
/Maniac/[Ll]ogs/
/Maniac/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Maniac/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Maniac/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Maniac/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Maniac/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/Maniac/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/Maniac/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Maniac/[Aa]ssets/[Ss]treamingAssets/aa/*

# /Maniac/[Ll]ibrary/[Pp]layer[Dd]ata[Cc]ache/[Ww]in64/[Dd]ata/sharedassets0.assets.resS

/Maniac/Library/PlayerDataCache/Win64/Data
/Maniac/Library/PlayerDataCache/Win64/Data
Maniac/Library/PlayerDataCache/Win64/Data/sharedassets0.assets.resS
