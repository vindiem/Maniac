  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5abfb0a229c98b3499cffa6c59c2ffb4, type: 3}
    m_FontSize: 34
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Game Controls\nMovement:\nMove your character: [Arrow Keys] or [W, A,
    S, D]\nJump: [Space] \u2013 Avoid obstacles or reach higher areas.\nCrouch: [C]
    \u2013 Hide behind objects or move under low obstacles.\n\nCombat (Murderer Only):\nAttack:
    [Left Mouse Button] \u2013 Strike victims to eliminate them.\nReveal all victims'
    locations: [X] \u2013 Temporarily highlight all victims, but with a cooldown.\n\nDoors:\nInteract:
    [E] \u2013 Open or close doors to block paths, trap opponents, or escape.\n\nTraps
    (Victims Only):\nPick up a trap: [F] \u2013 Find traps in the environment and
    collect them.\nPlace a trap: [G] \u2013 Drop a trap to slow down or immobilize
    the murderer.\n\nLight & Vision:\nToggle flashlight on/off: [Right Mouse Button]
    \u2013 Use it to navigate dark areas but be careful\u2014it may reveal your location.\n\nImportant
    Rules:\n\tTraps only affect the murderer \u2013 Use them strategically to slow
    down or escape.\n\tThe murderer can only attack victims \u2013 Stay hidden, use
    traps wisely, and work together to survive.\n\tDoors can be a key advantage \u2013
    Block paths or mislead the murderer to gain time.\n\tThe flashlight can help,
    but it also reveals your position \u2013 Use it carefully in dark areas.\n\tMurderer\u2019s
    highlight ability ([X]) \u2013 Can reveal all victims' positions but has a cooldown,
    so use it wisely."
